# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local está no .gitignore e não vai para o git.
#
# Os valores do Firebase estão em: Console do Firebase > Configurações do
# projeto > Seus apps > (app web) > Configuração do SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: chave da API do RAWG (https://rawg.io/apidocs) para o autocomplete
# de jogos. Sem ela, o formulário de sugestão funciona no preenchimento manual.
VITE_RAWG_API_KEY=
